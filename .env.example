# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bitika (M-Pesa -> sats collection). Switched off for now: fares go through
# Daraja below (see src/lib/collect.ts). Unused until Bitika is switched back on.
BITIKA_API_KEY=
# Confirm the real header name + secret with Bitika support before go-live
BITIKA_WEBHOOK_SECRET=

# LNbits SaaS instance (my.lnbits.com). The LNURLp extension must be enabled.
# LNBITS_ADMIN_KEY is the admin key of the super user's wallet; every vehicle
# wallet is created under that same account.
LNBITS_HOST=https://your-instance.lnbits.com
LNBITS_ADMIN_KEY=
# Creating wallets needs account-level auth (LNbits 1.x). Set ONE of:
#   LNBITS_ACCESS_TOKEN — an access token for your LNbits account (preferred)
#   LNBITS_USER_ID      — your LNbits account's user ID (NOT a wallet ID)
LNBITS_ACCESS_TOKEN=
LNBITS_USER_ID=

# Nostr (generate once, keep secret server-side; run `node scripts/gen-nostr-key.mjs`)
NOSTR_SECRET_KEY_HEX=
NEXT_PUBLIC_NOSTR_APP_PUBKEY=

# Onboarding admin (/admin/onboard) — any long passphrase; share only with staff
ADMIN_PASSCODE=

# Public URL of the deployed app, used in printed QR stickers (e.g. https://safaripap.vercel.app)
NEXT_PUBLIC_APP_URL=

# Optional demo phone (e.g. 0727358159): paying with this number skips Bitika
# and settles as paid after a few seconds. No money moves; fares are flagged
# as demo. Leave empty in normal use.
DEMO_PHONE=

# Daraja (Safaricom M-Pesa) STK push — how every fare is collected. Create an app at https://developer.safaricom.co.ke (My Apps) for the
# consumer key/secret. Sandbox shortcode 174379 and its passkey are on the
# Daraja "Lipa Na M-Pesa Online" test credentials page; for production use your
# own paybill/till and the passkey Safaricom emails after go-live.
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
# Public HTTPS base Daraja calls back to (your Vercel URL, or a cloudflared
# tunnel in local dev). The callback is <base>/api/hooks/payment-result.
DARAJA_CALLBACK_BASE_URL=
# Any long random string (e.g. `openssl rand -hex 24`); appended to the
# callback URL and checked, so only Daraja can mark a fare paid.
DARAJA_CALLBACK_TOKEN=

# Treasury: a pre-funded LNbits wallet that pays each vehicle its sats once
# Daraja confirms the fare. Create a wallet on
# the same LNbits instance (LNBITS_HOST), fund it, and copy its Admin key.
LNBITS_TREASURY_ADMIN_KEY=
# KES per 1 BTC, used only if the live price (Yadio, then LNbits) is down.
BTC_KES_FALLBACK=13000000
# Optional: fixed sats per KES to keep the treasury float small in demos.
DEMO_SATS_PER_KES=

# Optional: Claude-written AI summary on the owner/manager Forecast tab
# (/manage/forecast). Create a key at https://console.anthropic.com
# (Settings → API keys). Leave empty to hide the summary; only forecast
# aggregates are sent, never phone numbers or receipts.
ANTHROPIC_API_KEY=
